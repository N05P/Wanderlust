<% layout("/layouts/boilerplate") -%>
<body>
  <div class="edit-container">
    <h2>✏️ Edit Your Listing</h2>

    <form method="POST" action="/listings/<%= data._id %>?_method=PUT" class="edit-form" enctype="multipart/form-data">
      <div class="form-group">
        <label>Title</label>
        <input name="listing[title]" value="<%= data.title %>" type="text" required />
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea name="listing[description]" rows="5" required><%= data.description %></textarea>
      </div>

      <div class="form-group">
        <input name="listing[image]"  type="file" />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Price ($)</label>
          <input name="listing[price]" value="<%= data.price %>" type="number" min="0" step="0.01" />
        </div>

        <div class="form-group">
          <label>Country</label>
          <input name="listing[country]" value="<%= data.country %>" type="text" />
        </div>
      </div>

      <div class="form-group">
        <label>Location</label>
        <input name="listing[location]" value="<%= data.location %>" type="text" />
      </div>

      <button type="submit" class="submit-btn">💾 Save Changes</button>

      <a href="/listings/<%= data._id %>" class="back-link">← Back to listing</a>
    </form>
  </div>

  <script>
    // Highlight inputs on focus
    document.querySelectorAll('input, textarea').forEach(el => {
      el.addEventListener('focus', () => el.classList.add('input-focus'));
      el.addEventListener('blur', () => el.classList.remove('input-focus'));
    });
  </script>
</body>
