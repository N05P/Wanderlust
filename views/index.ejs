<% layout("/layouts/boilerplate") -%>

<body>
  <div class="container mt-4">
    <div class="airbnb-categories">

    <div class="cat">
        <i class="fa-solid fa-fire"></i>
        <span>Trending</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-bed"></i>
        <span>Rooms</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-city"></i>
        <span>Iconic Cities</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-chess-rook"></i>
        <span>Castles</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-person-swimming"></i>
        <span>Amazing Pools</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-cow"></i>
        <span>Farms</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-snowflake"></i>
        <span>Arctic</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-igloo"></i>
        <span>Domes</span>
    </div>

    <div class="cat">
        <i class="fa-solid fa-ship"></i>
        <span>Boats</span>
    </div>

    <!-- RIGHT SIDE TOGGLE -->
    <div class="tax-toggle">
        <span>Display total after taxes</span>
        <label class="switch">
            <input type="checkbox">
            <span class="slider"></span>
        </label>
    </div>

</div>
    <div class="listings-grid">
      <% for(let listing of data) { %>
        <div class="card listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>"> 
          <div class="card-body">
            <h5 class="card-title"><%= listing.location %></h5>
            <p class="card-text">
              Price:
              <span class="price-base">
                <%= listing.price %>
              </span>
            
              <span class="price-tax text-danger ms-1 d-none">
                (with 18% GST: <%= (listing.price * 1.18).toFixed(0) %>)
              </span>
            </p>

            <a href="/listings/<%=listing._id%>" class="btn btn-primary">View Details</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>


<script>
  const taxToggle = document.querySelector('.tax-toggle input[type="checkbox"]');
  const basePrices = document.querySelectorAll('.price-base');
  const taxPrices = document.querySelectorAll('.price-tax');

  taxToggle.addEventListener('change', () => {
    if (taxToggle.checked) {
      basePrices.forEach(b => b.classList.add('d-none'));
      taxPrices.forEach(t => t.classList.remove('d-none'));
    } else {
      basePrices.forEach(b => b.classList.remove('d-none'));
      taxPrices.forEach(t => t.classList.add('d-none'));
    }
  });
</script>
