<% layout("/layouts/boilerplate") -%>

<body>
  <div class="container mt-4">
  


    <!-- RIGHT SIDE TOGGLE -->
    <div class="tax-toggle">
        <span>Display total after taxes</span>
        <label class="switch">
            <input type="checkbox">
            <span class="slider"></span>
        </label>
    </div>


    <div class="listings-grid">
      <% for(let listing of data) { %>
        <div class="card listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>"> 
          <div class="card-body">
            <h5 class="card-title"><%= listing.location %></h5>
            <p class="card-text">
              Price:
              <span class="price-base">
                <%= listing.price %>
              </span>
            
              <span class="price-tax text-danger ms-1 d-none">
                (with 18% GST: <%= (listing.price * 1.18).toFixed(0) %>)
              </span>
            </p>

            <a href="/listings/<%=listing._id%>" class="btn btn-primary">View Details</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>


<script>
  const taxToggle = document.querySelector('.tax-toggle input[type="checkbox"]');
  const basePrices = document.querySelectorAll('.price-base');
  const taxPrices = document.querySelectorAll('.price-tax');

  taxToggle.addEventListener('change', () => {
    if (taxToggle.checked) {
      basePrices.forEach(b => b.classList.add('d-none'));
      taxPrices.forEach(t => t.classList.remove('d-none'));
    } else {
      basePrices.forEach(b => b.classList.remove('d-none'));
      taxPrices.forEach(t => t.classList.add('d-none'));
    }
  });
</script>
